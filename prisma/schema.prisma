generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  OVER_BUDGET
}

enum InvoiceStatus {
  pendente
  pago
  cancelado
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  plan      String   @default("freemium")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users       User[]
  clients     Client[]
  projects    Project[]
  timeEntries TimeEntry[]
  invoices    Invoice[]

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid())
  tenantId  String?
  email     String   @unique
  name      String
  password  String?
  avatarUrl String?
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  tenant      Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settings    UserSettings?
  timeEntries TimeEntry[]

  @@map("users")
}

// Configurações individuais do usuário
model UserSettings {
  id              String @id @default(uuid())
  userId          String @unique
  hourlyRateCents Int    @default(0)
  currency        String @default("BRL")
  theme           String @default("dark")
  pomodoroWork    Int    @default(25)
  pomodoroBreak   Int    @default(5)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Client {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  contact   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projects Project[]
  invoices Invoice[]

  @@map("clients")
}

model Project {
  id               String        @id @default(uuid())
  tenantId         String
  clientId         String?
  name             String
  budgetCents      Int?
  estimatedSeconds Int?
  status           ProjectStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]

  @@map("projects")
}

model TimeEntry {
  id              String    @id @default(uuid())
  tenantId        String
  userId          String
  projectId       String?
  description     String?
  start           DateTime
  end             DateTime?
  durationSeconds Int?
  amountCents     Int       @default(0)
  billable        Boolean   @default(true)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("time_entries")
}

model Invoice {
  id              String        @id @default(uuid())
  tenantId        String
  clientId        String
  monthRef        String
  durationSeconds Int           @default(0)
  amountCents     Int           @default(0)
  status          InvoiceStatus @default(pendente)
  aiSummary       String?       @db.Text
  pdfUrl          String?
  createdAt       DateTime      @default(now())
  paidAt          DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("invoices")
}
