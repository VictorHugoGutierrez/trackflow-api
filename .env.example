# SERVIDOR & AMBIENTE
PORT=3333
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# BASE DE DADOS (PostgreSQL - Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/trackflow?sslmode=require"

# AUTENTICAÇÃO & SESSÃO (JWT + Cookies)
# Gere uma string aleatória longa (mínimo 32 caracteres)
JWT_SECRET="defina_uma_chave_secreta_longa_aqui"
COOKIE_DOMAIN="localhost"

# PROVEDORES EXTERNOS
# Google Cloud Console (OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"

# Ollama (IA para Faturas e Resumos)
OLLAMA_API_URL="http://localhost:11434"
OLLAMA_API_MODEL="llama2"
# Resend (Disparo de E-mails)
RESEND_API_KEY="re_123456789"